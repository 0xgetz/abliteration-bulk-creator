# ---------------------------------------------------------------------------
# Abliteration Bulk Creator — configuration.
# Copy to .env and export, or set these in your shell before running.
# Every variable is optional; sensible defaults are built in.
# ---------------------------------------------------------------------------

# --- Batch -----------------------------------------------------------------
ABC_COUNT=5
ABC_CONCURRENCY=2
ABC_MIN_DELAY_MS=5000
ABC_MAX_DELAY_MS=14000
ABC_MAX_RETRIES=3

# --- Target ----------------------------------------------------------------
ABC_ORIGIN=https://abliteration.ai

# --- Inbox -----------------------------------------------------------------
# Real @gmail.com inboxes by default (required by abliteration.ai).
ABC_EMAILNATOR_URL=https://www.emailnator.com
# ABC_INBOX_PROVIDER=emailnator
# ABC_INBOX_FALLBACK=false

# --- Browser ---------------------------------------------------------------
ABC_HEADLESS=true
# ABC_BROWSER_CHANNEL=chrome
ABC_CODE_TIMEOUT_MS=180000

# --- Rotating proxy (strongly recommended) ---------------------------------
# A single datacenter IP will be blocked (HTTP 403) by Cloudflare Turnstile
# after the first account. Supply a residential/mobile rotating gateway.
#
# Easiest: drop your proxies in proxy.txt (one per line). Common formats:
#   host:port
#   host:port:user:pass
#   user:pass@host:port
#   http://user:pass@host:port
#   socks5://user:pass@host:port
ABC_PROXY_FILE=proxy.txt
ABC_PROXY_SCHEME=http
#
# Static list (round-robin), merged with proxy.txt:
# ABC_PROXIES=http://user:pass@1.2.3.4:8000,http://user:pass@5.6.7.8:8000
#
# Rotating gateway template ({session} -> new sticky IP per account):
# ABC_PROXY_TEMPLATE=http://user:pass@gw.provider.com:8000?session={session}
# ABC_PROXY_COUNTRY=us
